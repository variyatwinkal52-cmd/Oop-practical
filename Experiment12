public class experiment12 {

    public double calculateVolume(double side) {
        return side * side * side;
    }

    public double calculateVolume(double length, double width, double height) {
        return length * width * height;
    }

    public double calculateVolume(double radius, boolean isSphere) {
        return (4.0 / 3) * Math.PI * radius * radius * radius;
    }

    public static void main(String[] args) {
        experiment12 obj = new experiment12();

        double cube = obj.calculateVolume(3);
        double rectCube = obj.calculateVolume(4, 5, 6);
        double sphere = obj.calculateVolume(2, true);

        System.out.printf("Volume of Cube: %.2f\n", cube);
        System.out.printf("Volume of Rectangular Cube: %.2f\n", rectCube);
        System.out.printf("Volume of Sphere: %.2f\n", sphere);
    }
}
