import java.util.LinkedList;

public class Experiment32 {

    public static <T> boolean searchElement(LinkedList<T> list, T element) {
        return list.contains(element);
    }

    public static void main(String[] args) {

        LinkedList<Integer> rollNumbers = new LinkedList<>();
        rollNumbers.add(101);
        rollNumbers.add(102);
        rollNumbers.add(103);
        rollNumbers.add(104);

        System.out.println("Search 102 in roll numbers: " +
                searchElement(rollNumbers, 102));

        System.out.println("Search 200 in roll numbers: " +
                searchElement(rollNumbers, 200));

        LinkedList<String> names = new LinkedList<>();
        names.add("Ravi");
        names.add("Neha");
        names.add("Amit");
        names.add("Priya");

        System.out.println("Search 'Neha' in names: " +
                searchElement(names, "Neha"));

        System.out.println("Search 'John' in names: " +
                searchElement(names, "John"));
    }
}
